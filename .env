# =============================================
# STATIVA — Environment Variables Template
# Salin file ini menjadi file bernama: env.local
# Lalu isi nilainya sesuai lingkungan Anda
# =============================================

# Database PostgreSQL
POSTGRES_DB=stativa
POSTGRES_USER=stativa_user
POSTGRES_PASSWORD=stativa_secret_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://stativa_user:stativa_secret_2026@db:5432/stativa

# Backend FastAPI
BACKEND_PORT=8000
SECRET_KEY=ganti-dengan-random-string-yang-panjang-dan-aman

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# File Upload
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=20

# CORS (pisahkan dengan koma jika lebih dari satu origin)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost
